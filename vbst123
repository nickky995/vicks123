CREATE OR REPLACE VIEW V_INGESTION_SUMMARY_REPORT AS
WITH DATE_SPINE AS (
    SELECT DATEADD('day', SEQ4(), '2026-01-01'::DATE) AS CAL_DATE
    FROM TABLE(GENERATOR(ROWCOUNT => 1095))  -- ~3 years of days; adjust as needed
    QUALIFY CAL_DATE <= DATEADD('year', 1, CURRENT_DATE())
),
SRC AS (
    SELECT
        DATE(START_TIME) AS REC_DATE,
        CASE
            WHEN SRC_FILENAME ILIKE '%PROV_GRP%' THEN 'GROUP'
            WHEN SRC_FILENAME ILIKE '%PRACTITIONER%' THEN 'PRACTITIONER'
        END AS FILE_TYPE,
        START_TIME,
        END_TIME,
        SUCCESS_COUNT,
        FAILURE_COUNT,
        TOTAL_COUNT
    FROM PDT_ETL_JOB_SUMMARY
),
GRP_AGG AS (
    SELECT REC_DATE,
        COUNT(*) AS FILE_COUNT,
        MIN(START_TIME) AS FIRST_START,
        MAX(END_TIME) AS LAST_END,
        SUM(SUCCESS_COUNT) AS SUCCESS_SUM,
        SUM(FAILURE_COUNT) AS REJECTED_SUM,
        SUM(TOTAL_COUNT) AS TOTAL_SUM
    FROM SRC WHERE FILE_TYPE = 'GROUP'
    GROUP BY REC_DATE
),
PRAC_AGG AS (
    SELECT REC_DATE,
        COUNT(*) AS FILE_COUNT,
        MIN(START_TIME) AS FIRST_START,
        MAX(END_TIME) AS LAST_END,
        SUM(SUCCESS_COUNT) AS SUCCESS_SUM,
        SUM(FAILURE_COUNT) AS REJECTED_SUM,
        SUM(TOTAL_COUNT) AS TOTAL_SUM
    FROM SRC WHERE FILE_TYPE = 'PRACTITIONER'
    GROUP BY REC_DATE
)
SELECT
    DS.CAL_DATE AS START_DATE,
    INITCAP(TO_CHAR(DS.CAL_DATE, 'DY')) AS DAY_OF_WEEK,
    CASE WHEN G.REC_DATE IS NOT NULL OR P.REC_DATE IS NOT NULL THEN 'Completed' END AS STATUS,
    G.REC_DATE AS GROUP_ETL_DATE,
    G.FILE_COUNT AS GROUP_FILE_COUNT,
    P.REC_DATE AS PRAC_ETL_DATE,
    P.FILE_COUNT AS PRAC_FILE_COUNT,
    ROUND(
        DATEDIFF('second',
            LEAST(COALESCE(G.FIRST_START, P.FIRST_START), COALESCE(P.FIRST_START, G.FIRST_START)),
            GREATEST(COALESCE(G.LAST_END, P.LAST_END), COALESCE(P.LAST_END, G.LAST_END))
        ) / 60.0, 0
    ) AS PROCESSING_TIME_MINUTES,
    G.SUCCESS_SUM AS GROUP_SUCCESS,
    G.REJECTED_SUM AS GROUP_REJECTED,
    G.TOTAL_SUM AS GROUP_TOTAL,
    ROUND(G.SUCCESS_SUM / NULLIF(G.TOTAL_SUM,0) * 100, 2) AS GROUP_SUCCESS_RATE,
    P.SUCCESS_SUM AS PRAC_SUCCESS,
    P.REJECTED_SUM AS PRAC_REJECTED,
    P.TOTAL_SUM AS PRAC_TOTAL,
    ROUND(P.SUCCESS_SUM / NULLIF(P.TOTAL_SUM,0) * 100, 2) AS PRAC_SUCCESS_RATE
FROM DATE_SPINE DS
LEFT JOIN GRP_AGG G ON G.REC_DATE = DS.CAL_DATE
LEFT JOIN PRAC_AGG P ON P.REC_DATE = DS.CAL_DATE
ORDER BY DS.CAL_DATE;
