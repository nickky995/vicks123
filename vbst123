CREATE OR REPLACE VIEW V_MASTER_ID_SUMMARY_REPORT AS
WITH parsed AS (
    SELECT
        TASK_DATE,
        PRACTITIONER_COUNT,
        ORGANIZATION_COUNT,
        LOCATION_COUNT,
        TO_DATE(
            LEFT(REGEXP_SUBSTR(SRC_FILENAME, '_([0-9]{14})\\.txt$', 1, 1, 'e', 1), 8),
            'YYYYMMDD'
        ) AS RUN_DATE
    FROM PDT_MASTER_ID_RETRIEVE_JOB_SUMMARY
)
SELECT
    TASK_DATE                      AS RESOURCE_UPDATE_DATE,
    MAX(RUN_DATE)                  AS RUN_DATE,
    DAYNAME(MAX(RUN_DATE))         AS DAY,
    SUM(PRACTITIONER_COUNT)        AS PRACTITIONER,
    SUM(ORGANIZATION_COUNT)        AS ORGANIZATION,
    SUM(LOCATION_COUNT)            AS LOCATION,
    SUM(PRACTITIONER_COUNT) + SUM(ORGANIZATION_COUNT) + SUM(LOCATION_COUNT) AS TOTALS
FROM parsed
GROUP BY TASK_DATE
ORDER BY TASK_DATE;
