CREATE OR REPLACE VIEW V_SUBMISSION_RESOURCE_DETAIL AS
SELECT
    DATE(START_TIME)                  AS START_DATE,
    RESOURCE_TYPE,
    DAYNAME(DATE(START_TIME))         AS DAY,
    IFF(SUM(IFF(STATUS = 'ERROR', 1, 0)) > 0, 'ERROR', 'COMPLETED') AS STATUS,
    ROUND(DATEDIFF('second', MIN(START_TIME), MAX(END_TIME)) / 3600.0, 2) AS PROCESSING_TIME_HOURS,
    IFF(DATEDIFF('second', MIN(START_TIME), MAX(END_TIME)) > 0,
        ROUND(SUM(TOTAL_COUNT) / (DATEDIFF('second', MIN(START_TIME), MAX(END_TIME)) / 3600.0), 0),
        NULL)                          AS PROCESSING_RATE,
    SUM(SUCCESS_COUNT)                 AS ACCEPTED,
    SUM(FAILURE_COUNT)                 AS REJECTED,
    SUM(TOTAL_COUNT)                   AS TOTAL,
    IFF(SUM(TOTAL_COUNT) > 0, ROUND(SUM(SUCCESS_COUNT) / SUM(TOTAL_COUNT), 4), NULL) AS ACCEPTED_PCT
FROM PDT_SUBMISSION_JOB_SUMMARY
GROUP BY DATE(START_TIME), RESOURCE_TYPE
ORDER BY START_DATE;


CREATE OR REPLACE VIEW V_TERMINATING_PROVIDER_SUMMARY AS
WITH parsed AS (
    SELECT
        TASK_DATE,
        START_TIME,
        END_TIME,
        PRACTITIONER_ROLE_COUNT,
        ORGANIZATION_AFFILIATION_COUNT,
        TO_DATE(
            LEFT(REGEXP_SUBSTR(SRC_FILENAME, '_([0-9]{14})\\.txt$', 1, 1, 'e', 1), 8),
            'YYYYMMDD'
        ) AS RUN_DATE
    FROM PDT_TERMINATING_PROVIDER_RETRIEVE_JOB_SUMMARY
)
SELECT
    TASK_DATE                         AS RESOURCE_UPDATE_DATE,
    MAX(RUN_DATE)                     AS RUN_DATE,
    DAYNAME(MAX(RUN_DATE))            AS DAY,
    ROUND(SUM(DATEDIFF('second', START_TIME, END_TIME)) / 60.0, 0) AS PROCESSING_TIME_MINUTES,
    SUM(PRACTITIONER_ROLE_COUNT)      AS PRACTITIONER_ROLE,
    SUM(ORGANIZATION_AFFILIATION_COUNT) AS ORGANIZATION_AFFILIATION,
    SUM(PRACTITIONER_ROLE_COUNT) + SUM(ORGANIZATION_AFFILIATION_COUNT) AS TOTALS
FROM parsed
GROUP BY TASK_DATE
ORDER BY TASK_DATE;


CREATE OR REPLACE VIEW V_NOT_YET_PROCESSED_BY_BCBSA AS
WITH parsed AS (
    SELECT
        RESOURCE_TYPE,
        RESOURCE_ID,
        CONSUMPTION_AVAILABLE_TIMESTAMP        AS SUBMISSION_TIMESTAMP,
        TO_TIMESTAMP(
            REGEXP_SUBSTR(SRC_FILENAME, '_([0-9]{14})_', 1, 1, 'e', 1),
            'YYYYMMDDHH24MISS'
        ) AS VALIDATION_RUN_TIME
    FROM PDT_REPORTING_ANALYTICS_CONSUMPTION
),
last_run AS (
    SELECT RESOURCE_TYPE, MAX(VALIDATION_RUN_TIME) AS LAST_VALIDATION_RUN
    FROM parsed
    GROUP BY RESOURCE_TYPE
),
aged AS (
    SELECT
        p.RESOURCE_TYPE,
        p.RESOURCE_ID,
        p.SUBMISSION_TIMESTAMP,
        lr.LAST_VALIDATION_RUN,
        DATEDIFF('second', p.SUBMISSION_TIMESTAMP, lr.LAST_VALIDATION_RUN) / 3600.0 AS AGING_HOURS
    FROM parsed p
    JOIN last_run lr ON p.RESOURCE_TYPE = lr.RESOURCE_TYPE
)
SELECT
    RESOURCE_TYPE,
    RESOURCE_ID,
    SUBMISSION_TIMESTAMP,
    LAST_VALIDATION_RUN,
    ROUND(AGING_HOURS, 2)                       AS AGING_HOURS,
    CASE
        WHEN AGING_HOURS <= 2   THEN '0-2 Hours'
        WHEN AGING_HOURS <= 12  THEN '2-12 Hours'
        WHEN AGING_HOURS <= 24  THEN '12-24 Hours'
        WHEN AGING_HOURS <= 168 THEN '1-7 Days'
        ELSE '7+ Days'
    END                                          AS AGING_BUCKET
FROM aged
WHERE AGING_HOURS > 2   -- past SLA, hence "not yet processed"
   OR SUBMISSION_TIMESTAMP IS NULL
ORDER BY RESOURCE_TYPE, AGING_HOURS DESC;





