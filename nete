    UNION ALL SELECT 'ERR_CENSUS_REF_SDOH_ATTRIBUTION'
    UNION ALL SELECT 'ERR_CENSUS_REF_SDOH_OBSERVATION'
    UNION ALL SELECT 'ERR_DHCS_CCS_SAF'
    UNION ALL SELECT 'ERR_LA_CARE_CCS_SAF'
    UNION ALL SELECT 'ERR_NTA_NDW_ATTRIBUTION'
    UNION ALL SELECT 'ERR_NTA_PAYMENT'
)
SELECT  s.nm            AS excel_name,
        o.OBJNAME       AS actual_table,
        o.CREATEDATE,
        t.RELTUPLES     AS est_rows,     -- from statistics, may be stale
        'SELECT ''' || o.OBJNAME || ''' AS tbl, COUNT(*) AS row_cnt, '
          || 'COUNT(DISTINCT CREATEXID) AS load_txns '
          || 'FROM RAWSTG_SRC_P1.NZ_SCRM.' || o.OBJNAME
          || ' UNION ALL'  AS count_sql
FROM    src_list s
LEFT JOIN _V_OBJECT_DATA o
       ON  o.DBNAME = 'RAWSTG_SRC_P1'
       AND o.SCHEMA = 'NZ_SCRM'
       AND o.OBJTYPE = 'TABLE'
       AND POSITION(s.nm IN o.OBJNAME) > 0
LEFT JOIN _V_TABLE t ON t.OBJID = o.OBJID
ORDER BY s.nm;




-- WITH src_list AS ( ...same 41 rows... )
SELECT  c.NAME AS tbl, c.ATTNAME, c.FORMAT_TYPE,
        'SELECT ''' || c.NAME || ''' AS tbl, ''' || c.ATTNAME || ''' AS col, '
          || 'CAST(MIN(' || c.ATTNAME || ') AS TIMESTAMP) AS first_dt, '
          || 'CAST(MAX(' || c.ATTNAME || ') AS TIMESTAMP) AS last_dt, '
          || 'COUNT(DISTINCT ' || c.ATTNAME || ') AS distinct_dts '
          || 'FROM RAWSTG_SRC_P1.NZ_SCRM.' || c.NAME || ' UNION ALL' AS date_sql
FROM    src_list s
JOIN    _V_RELATION_COLUMN c
       ON  c.SCHEMA = 'NZ_SCRM'
       AND POSITION(s.nm IN c.NAME) > 0
WHERE   (c.FORMAT_TYPE LIKE 'DATE%' OR c.FORMAT_TYPE LIKE 'TIMESTAMP%')
ORDER BY 1, 2;




