CREATE OR REPLACE PROCEDURE ARCHIVE_TABLES_WITH_TAGS(
    SRC_SCHEMA VARCHAR,   -- source schema, UPPERCASE
    TGT_SCHEMA VARCHAR,   -- archive schema, UPPERCASE
    SUFFIX     VARCHAR    -- e.g. '_ARCH'
)
RETURNS VARCHAR
LANGUAGE SQL
EXECUTE AS CALLER
AS
$$
DECLARE
  db     VARCHAR DEFAULT CURRENT_DATABASE();
  tgt    VARCHAR;
  stmt   VARCHAR;
  n_tbl  INTEGER DEFAULT 0;
  n_tag  INTEGER DEFAULT 0;
  n_err  INTEGER DEFAULT 0;
  rs_tbl RESULTSET;
  rs_tag RESULTSET;
BEGIN
  ---------------------------------------------------------------
  -- 1) Create archive tables + add audit columns
  ---------------------------------------------------------------
  rs_tbl := (SELECT TABLE_NAME
             FROM INFORMATION_SCHEMA.TABLES
             WHERE TABLE_SCHEMA = :SRC_SCHEMA
               AND TABLE_TYPE  = 'BASE TABLE');
  LET c_tbl CURSOR FOR rs_tbl;

  FOR t IN c_tbl DO
    tgt := '"' || db || '"."' || TGT_SCHEMA || '"."' || t.TABLE_NAME || SUFFIX || '"';

    -- Empty copy of the source structure
    stmt := 'CREATE TABLE IF NOT EXISTS ' || tgt
         || ' LIKE "' || db || '"."' || SRC_SCHEMA || '"."' || t.TABLE_NAME || '"';
    EXECUTE IMMEDIATE :stmt;

    -- Archive audit columns (safe on re-run)
    stmt := 'ALTER TABLE ' || tgt || ' ADD COLUMN IF NOT EXISTS ARCHIVE_DATE VARCHAR(8)';
    EXECUTE IMMEDIATE :stmt;

    stmt := 'ALTER TABLE ' || tgt || ' ADD COLUMN IF NOT EXISTS ARCHIVE_RUN_TS TIMESTAMP_NTZ(9)';
    EXECUTE IMMEDIATE :stmt;

    stmt := 'ALTER TABLE ' || tgt || ' ADD COLUMN IF NOT EXISTS ARCHIVE_BATCH_ID VARCHAR';
    EXECUTE IMMEDIATE :stmt;

    n_tbl := n_tbl + 1;
  END FOR;

  ---------------------------------------------------------------
  -- 2) Copy table-level and column-level tags from source
  ---------------------------------------------------------------
  rs_tag := (SELECT OBJECT_NAME, DOMAIN, COLUMN_NAME,
                    TAG_DATABASE, TAG_SCHEMA, TAG_NAME, TAG_VALUE
             FROM SNOWFLAKE.ACCOUNT_USAGE.TAG_REFERENCES
             WHERE OBJECT_DATABASE = :db
               AND OBJECT_SCHEMA   = :SRC_SCHEMA
               AND OBJECT_DELETED IS NULL
               AND DOMAIN IN ('TABLE', 'COLUMN'));
  LET c_tag CURSOR FOR rs_tag;

  FOR r IN c_tag DO
    stmt := 'ALTER TABLE "' || db || '"."' || TGT_SCHEMA || '"."'
         || r.OBJECT_NAME || SUFFIX || '"'
         || IFF(r.DOMAIN = 'COLUMN', ' MODIFY COLUMN "' || r.COLUMN_NAME || '"', '')
         || ' SET TAG "' || r.TAG_DATABASE || '"."' || r.TAG_SCHEMA || '"."'
         || r.TAG_NAME || '" = ''' || REPLACE(r.TAG_VALUE, '''', '''''') || '''';
    BEGIN
      EXECUTE IMMEDIATE :stmt;
      n_tag := n_tag + 1;
    EXCEPTION
      WHEN OTHER THEN n_err := n_err + 1;   -- continue on failure
    END;
  END FOR;

  RETURN 'Tables: ' || n_tbl || ' | Tags applied: ' || n_tag || ' | Tag errors: ' || n_err;
END;
$$;



USE DATABASE MY_DB;
CALL ARCHIVE_TABLES_WITH_TAGS('SRC_SCHEMA', 'ARCHIVE_SCHEMA', '_ARCH');



-- New columns present?
DESC TABLE MY_DB.ARCHIVE_SCHEMA.STATE_ARCH;

-- Tags copied?
SELECT COLUMN_NAME, TAG_NAME, TAG_VALUE
FROM TABLE(MY_DB.INFORMATION_SCHEMA.TAG_REFERENCES_ALL_COLUMNS(
       'MY_DB.ARCHIVE_SCHEMA.STATE_ARCH', 'table'));



CREATE OR REPLACE PROCEDURE GENERATE_ARCHIVE_DDLS(
    TGT_SCHEMA VARCHAR,                    -- schema holding archive tables, UPPERCASE
    SUFFIX     VARCHAR DEFAULT '_ARCHIVE'  -- table name ending to match
)
RETURNS VARCHAR
LANGUAGE SQL
EXECUTE AS CALLER
AS
$$
DECLARE
  fq     VARCHAR;
  ddl    VARCHAR;
  script VARCHAR DEFAULT '';
  n      INTEGER DEFAULT 0;
  rs     RESULTSET;
BEGIN
  rs := (SELECT TABLE_NAME
         FROM INFORMATION_SCHEMA.TABLES
         WHERE TABLE_SCHEMA = :TGT_SCHEMA
           AND TABLE_TYPE  = 'BASE TABLE'
           AND ENDSWITH(TABLE_NAME, :SUFFIX)
         ORDER BY TABLE_NAME);
  LET c CURSOR FOR rs;

  FOR t IN c DO
    fq := TGT_SCHEMA || '."' || t.TABLE_NAME || '"';   -- no DB name: portable across envs
    SELECT GET_DDL('TABLE', :fq) INTO :ddl;

    -- Safe for target env: never replace existing tables
    ddl := REPLACE(ddl, 'create or replace TABLE', 'CREATE TABLE IF NOT EXISTS');
    ddl := REPLACE(ddl, 'create or replace table', 'CREATE TABLE IF NOT EXISTS');

    script := script || '-- ' || t.TABLE_NAME || CHR(10) || ddl || CHR(10) || CHR(10);
    n := n + 1;
  END FOR;

  RETURN '-- ' || n || ' archive tables' || CHR(10) || CHR(10) || script;
END;
$$;



USE DATABASE MY_DB;
CALL GENERATE_ARCHIVE_DDLS('ARCHIVE_SCHEMA', '_ARCHIVE');
